# Copiez ce fichier sous le nom .env (dans le même dossier), puis remplissez-le.
# Le fichier .env contient des secrets : ne l'envoyez à personne et ne le publiez pas.

# Où envoyer les requêtes : anthropic (API Anthropic directe). « foundry » est abandonné (D54) : reste du banc Python périmé.
FOURNISSEUR=anthropic

# Modèle utilisé par l'agent
MODELE=claude-sonnet-5-5

# Niveau de réflexion : low, medium ou high (laisser vide pour la valeur par défaut du modèle)
EFFORT=medium

# --- API Anthropic (FOURNISSEUR=anthropic) ---
ANTHROPIC_API_KEY=

# --- Microsoft Foundry : ABANDONNÉ (D54), variables sans usage ---
# Nom de la ressource, ex. assistant-famille-pilot-resource
FOUNDRY_RESOURCE=
FOUNDRY_API_KEY=
