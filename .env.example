# ---------------------------------------------------------------
# MAAQ — variables d'environnement
# Copier ce fichier en .env puis adapter. Ne jamais commiter .env.
# ---------------------------------------------------------------

# Connexion PostgreSQL. En développement, `npm run dev` démarre une base embarquée
# sur ce port (aucune installation nécessaire).
DATABASE_URL=postgres://maaq:maaq@localhost:5433/maaq

# Port de la base embarquée de développement (doit correspondre à DATABASE_URL).
DEV_DB_PORT=5433

# Adresse publique de l'application : sert à construire les liens envoyés par email/SMS.
APP_URL=http://localhost:3000

# Clé AES-256 (32 octets en base64) qui chiffre les informations saisies pour les agents.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Clé HMAC (32 octets en base64) pour l'empreinte de l'email du consentant (D13).
# À conserver hors base et à sauvegarder à part.
HMAC_KEY=

# Clé (32 octets en base64) qui signe les jetons de connexion (vérification, déverrouillage)
# et protège les codes et schémas tactiles stockés.
AUTH_SECRET=

# Digitorn (agents IA) : "mock" = simulateur local ; "live" = vraie API (pas encore disponible).
DIGITORN_MODE=mock
# DIGITORN_API_URL=
# DIGITORN_API_KEY=

# Emails et SMS : "dev" = boîte de test consultable sur /dev/boite ; pas d'envoi réel.
MESSAGING_MODE=dev            # « smtp » : les emails partent réellement (voir plus bas)

# Stockage des documents de contrats : "local" = faux Google Drive dans .data/drive.
DRIVE_MODE=local

# Secret partagé qui protège les traitements planifiés (/api/cron/*).
CRON_SECRET=

# Tests : base PostgreSQL à utiliser au lieu de la base embarquée temporaire (utilisée par la CI).
# TEST_DATABASE_URL=

# Secret de l'outil de facturation (désabonnements, réabonnements) : généré automatiquement en local
BILLING_WEBHOOK_SECRET=

# --- Environnement en ligne (zone de test, production) : voir docs/deploiement-test.md ---
# Base hébergée (Supabase, Cloud SQL…) : DATABASE_SSL=require active la connexion chiffrée (sans `sslmode` dans l'adresse).
# DATABASE_SSL=
# Zone de test : active les outils de développement, réservés à qui détient la clé (ouvrir /dev/boite?cle=<clé>).
# MAAQ_ZONE=test
# MAAQ_DEV_TOOLS_KEY=
# Mot de passe des comptes de démonstration créés par `npm run db:seed` (par défaut : celui de docs/comptes-de-test.md).
# DEMO_PASSWORD=
# MAAQ_SCHEDULER=off  # hors développement, un planificateur externe appelle /api/cron/run

# --- Envoi réel des emails (MESSAGING_MODE=smtp), par exemple avec Brevo : voir docs/emails-brevo.md ---
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="MAAQ <ne-pas-repondre@maaq.fr>"

