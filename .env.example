# ---------------------------------------------------------------
# MAAQ — variables d'environnement
# Copier ce fichier en .env puis adapter. Ne jamais commiter .env.
# ---------------------------------------------------------------

# Connexion PostgreSQL. En développement, `npm run dev` démarre une base embarquée
# sur ce port (aucune installation nécessaire).
DATABASE_URL=postgres://maaq:maaq@localhost:5433/maaq

# Port de la base embarquée de développement (doit correspondre à DATABASE_URL).
DEV_DB_PORT=5433

# Adresse publique de l'application : sert à construire les liens envoyés par email/SMS.
APP_URL=http://localhost:3000

# Clé AES-256 (32 octets en base64) qui chiffre les informations saisies pour les agents.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Clé HMAC (32 octets en base64) pour l'empreinte de l'email du consentant (D13).
# À conserver hors base et à sauvegarder à part.
HMAC_KEY=

# Digitorn (agents IA) : "mock" = simulateur local ; "live" = vraie API (pas encore disponible).
DIGITORN_MODE=mock
# DIGITORN_API_URL=
# DIGITORN_API_KEY=

# Emails et SMS : "dev" = boîte de test consultable sur /dev/boite ; pas d'envoi réel.
MESSAGING_MODE=dev

# Stockage des documents de contrats : "local" = faux Google Drive dans .data/drive.
DRIVE_MODE=local

# Secret partagé qui protège les traitements planifiés (/api/cron/*).
CRON_SECRET=

# Tests : base PostgreSQL à utiliser au lieu de la base embarquée temporaire (utilisée par la CI).
# TEST_DATABASE_URL=
