{
  "name": "maaq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MAAQ — agents IA pour l'administratif et le quotidien du foyer",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:next": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "tsx scripts/db-start.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "deploy:secrets": "tsx scripts/gen-secrets.ts",
    "check:release": "tsx scripts/check-release.ts",
    "db:types": "kysely-codegen --dialect postgres --out-file src/server/db/schema.generated.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "kysely": "^0.29.6",
    "next": "^16.3.8",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "kysely-codegen": "^0.20.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "@embedded-postgres/windows-x64@17.10.0-beta.17": true
  }
}
